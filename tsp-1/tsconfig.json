{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS" /* or NodeNext if you want ES Modules */,
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    "exclude": ["tests/**/*"]
}
